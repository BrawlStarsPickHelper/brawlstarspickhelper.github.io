# 브롤스타즈 개발자 포털에서 발급받은 API 키
# ⚠️ 키 발급 시 IP 화이트리스트에 45.79.218.79 (RoyaleAPI 프록시) 를 등록해야 함
BS_API_KEY=

# Supabase 프로젝트 설정 (Project Settings > API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=   # service_role 키 (절대 프론트/공개 저장소에 노출 금지)

# 선택 설정
MIN_RANK_TROPHY=19      # 실제 배틀로그 확인 후 정확한 값으로 수정
TAGS_PER_RUN=50
